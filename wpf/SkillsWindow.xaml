<Window x:Class="KimiPlanbarTray.SkillsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="404" Height="520" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- Margin 28 is shadow fade room: lets the BlurRadius=24 shadow decay
         to zero before the window edge (same chrome as SettingsWindow) -->
    <Border CornerRadius="14" Background="{DynamicResource WindowBgBrush}" Margin="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（可拖动） -->
            <DockPanel Grid.Row="0" Margin="2,0,2,16" MouseLeftButtonDown="TitleBarDrag">
                <Image Source="pack://application:,,,/kimi-logo.png" Width="18" Height="18"
                       DockPanel.Dock="Left"/>
                <TextBlock Text="Kimi Skills" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="✕" Style="{StaticResource ChromeCloseButton}"
                        DockPanel.Dock="Right" Click="CloseClick"/>
            </DockPanel>

            <!-- 汇总行：计数文字 + 手动重扫（SPEC 21.2） -->
            <DockPanel Grid.Row="1" Margin="6,0,4,10">
                <Button Content="⟳ Refresh" Style="{StaticResource MiniButton}"
                        DockPanel.Dock="Right" Click="RefreshClick"/>
                <TextBlock x:Name="SummaryText" Text="Loading…" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 分组只读技能列表（SPEC 21.3） -->
            <ScrollViewer Grid.Row="2" Margin="6,0,4,0" VerticalScrollBarVisibility="Auto"
                          Focusable="False">
                <ScrollViewer.Resources>
                    <!-- 窄滚动条：透明轨道 + 主题色圆角滑块（rust .list::-webkit-scrollbar） -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{DynamicResource ProgressTrackBrush}"
                                                                    CornerRadius="4" Margin="1,0"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel x:Name="ListPanel" Margin="0,0,4,0"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
