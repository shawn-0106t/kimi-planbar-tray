<Window x:Class="KimiPlanbarTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="404" Height="464" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- Margin 28 is shadow fade room: lets the BlurRadius=24 shadow decay
         to zero before the window edge (window grew by 2*(28-6) to keep the
         visual card size unchanged) -->
    <Border CornerRadius="14" Background="{DynamicResource WindowBgBrush}" Margin="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（可拖动） -->
            <DockPanel Grid.Row="0" Margin="2,0,2,16" MouseLeftButtonDown="TitleBarDrag">
                <Image Source="pack://application:,,,/kimi-logo.png" Width="18" Height="18"
                       DockPanel.Dock="Left"/>
                <TextBlock Text="Kimi Planbar Tray Settings" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="✕" Style="{StaticResource ChromeCloseButton}"
                        DockPanel.Dock="Right" Click="CloseClick"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="6,0,4,0">
                <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <RadioButton x:Name="ThemeSystem" Content="System default" Margin="0,10,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>
                <RadioButton x:Name="ThemeLight" Content="Moonlit (light)" Margin="0,8,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>
                <RadioButton x:Name="ThemeDark" Content="Moondark (dark)" Margin="0,8,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>

                <TextBlock Text="Refresh interval" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton Content="1 min" Tag="1" GroupName="interval"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="5 min" Tag="5" GroupName="interval" IsChecked="True"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="10 min" Tag="10" GroupName="interval"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="30 min" Tag="30" GroupName="interval"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>

                <CheckBox x:Name="AutoStartBox" Content="Launch at Windows startup" Margin="0,22,0,0"
                          Style="{StaticResource ThemeCheckBox}"/>

                <Button Content="Save" Style="{StaticResource ActionButton}" Margin="0,26,0,0"
                        Click="SaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
