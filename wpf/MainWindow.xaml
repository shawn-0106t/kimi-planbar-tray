<Window x:Class="KimiPlanbarTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="424" Height="520" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- Margin 28 is shadow fade room: lets the BlurRadius=24 shadow decay
         to zero before the window edge (window grew by 2*(28-6) to keep the
         visual card size unchanged) -->
    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource WindowBgBrush}" Margin="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <DockPanel Grid.Row="0" Margin="2,0,2,16">
                <Image Source="pack://application:,,,/kimi-logo.png" Width="20" Height="20"
                       DockPanel.Dock="Left"/>
                <TextBlock Text="Kimi Planbar Tray" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock x:Name="LastUpdated" Text="" FontSize="11" DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>

            <!-- 用量卡片 -->
            <primitives:UniformGrid Grid.Row="1" Columns="2">
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Weekly usage" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="WeekPct" Text="--" FontSize="32" FontWeight="Bold" Margin="0,10,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid Height="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="WeekBarCol" Width="0*"/>
                                <ColumnDefinition x:Name="WeekRestCol" Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource ProgressTrackBrush}"/>
                            <Border Grid.Column="0" CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="WeekReset" Text="" FontSize="11" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="5-hour usage" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="FivePct" Text="--" FontSize="32" FontWeight="Bold" Margin="0,10,0,10"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid Height="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FiveBarCol" Width="0*"/>
                                <ColumnDefinition x:Name="FiveRestCol" Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource ProgressTrackBrush}"/>
                            <Border Grid.Column="0" CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="FiveReset" Text="" FontSize="11" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </primitives:UniformGrid>

            <!-- Extra Usage 卡片 -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="12"
                    Padding="16,12" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Extra Usage" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ExtraBalance" Text="--" FontSize="18" FontWeight="Bold"
                                   DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    <StackPanel x:Name="ExtraMonthlyPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid Height="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ExtraBarCol" Width="0*"/>
                                <ColumnDefinition x:Name="ExtraRestCol" Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource ProgressTrackBrush}"/>
                            <Border Grid.Column="0" CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <TextBlock x:Name="ExtraMonthly" Text="" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 版本行（整行点击跳转 Releases；SPEC 15.3 光晕见 VersionButton） -->
            <Button Grid.Row="3" Style="{StaticResource VersionButton}" Margin="0,12,0,12"
                    ToolTip="View Kimi Code releases" Click="OpenReleases">
                <DockPanel>
                    <TextBlock Text="Kimi Code CLI" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="CliVersion" Text="--" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <Border x:Name="NewVersionBadge" Visibility="Collapsed" CornerRadius="8"
                                Padding="8,2" Margin="8,0,0,0"
                                Background="{DynamicResource BadgeBgBrush}">
                            <TextBlock Text="Update available" FontSize="11" Foreground="{DynamicResource BadgeFgBrush}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Bottom buttons (SPEC 12.7): icon on top, label below; icons are
                 StreamGeometry transcriptions of the rust/index.html inline SVGs.
                 The Path MUST carry explicit Width/Height=24: Viewbox scales by
                 the child's DesiredSize and a bare Path measures its own geometry
                 bounds, which renders icons oversized with per-icon scale drift.
                 With the explicit size the scaling matches SVG viewBox semantics. -->
            <primitives:UniformGrid Grid.Row="4" Columns="4">
                <Button Style="{StaticResource IconActionButton}" Click="ConsoleClick"
                        ToolTip="Open Kimi Code Console" Margin="0,0,6,0">
                    <StackPanel>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconConsole}" Width="24" Height="24"
                                  Fill="{DynamicResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Text="Console" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconActionButton}" Click="RefreshClick" Margin="3,0">
                    <StackPanel>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconRefresh}" Width="24" Height="24"
                                  Fill="{DynamicResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Text="Refresh" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconActionButton}" Click="SettingsClick" Margin="3,0">
                    <StackPanel>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconSettings}" Width="24" Height="24"
                                  Fill="{DynamicResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Text="Settings" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconActionButton}" Click="ExitClick" Margin="6,0,0,0">
                    <StackPanel>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconExit}" Width="24" Height="24"
                                  Fill="{DynamicResource TextPrimaryBrush}"/>
                        </Viewbox>
                        <TextBlock Text="Exit" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </primitives:UniformGrid>
        </Grid>
    </Border>
</Window>
