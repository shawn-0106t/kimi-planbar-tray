<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 月之暗面 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1A88FF"/>
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF17191E"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF23262D"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F3F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA0A8"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF3A3E47"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#FF2C3039"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF3A404B"/>
    <SolidColorBrush x:Key="BadgeBgBrush" Color="#FF3D2E1A"/>
    <SolidColorBrush x:Key="BadgeFgBrush" Color="#FFF0A040"/>
    <!-- SPEC 15.3 hover glow：accent 描边 1px 45% + 光晕 10px 22%（暗面更强，
         参数对齐 rust theme.css 的 .btn::after 暗面值） -->
    <SolidColorBrush x:Key="GlowStrokeBrush" Color="#731A88FF"/>
    <sys:Double x:Key="GlowBlurRadius">10</sys:Double>
    <sys:Double x:Key="GlowHaloOpacity">0.22</sys:Double>
</ResourceDictionary>
