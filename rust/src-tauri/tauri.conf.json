{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KimiPlanbarTray",
  "version": "1.7.1",
  "identifier": "com.shawnqi.kimiplanbartray",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kimi Planbar Tray",
        "url": "index.html",
        "width": 424,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Kimi Planbar Tray Settings",
        "url": "settings.html",
        "width": 404,
        "height": 464,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "skills",
        "title": "Kimi Skills",
        "url": "skills.html",
        "width": 404,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false
      },
      {
        "label": "menu",
        "title": "Kimi Planbar Tray Menu",
        "url": "menu.html",
        "width": 188,
        "height": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
