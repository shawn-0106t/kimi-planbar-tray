<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KimiPlanbarTray</AssemblyName>
    <RootNamespace>KimiPlanbarTray</RootNamespace>
    <Version>1.1.0</Version>
    <Description>Kimi Code 套餐额度托盘监控</Description>
    <!-- 显式锁定系统级 DPI 感知：Cursor.Position(物理像素) 与 WPF DIP 的换算
         语义依赖此设置，缺失时行为由 OS 默认决定，高 DPI 下菜单坐标会漂移 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="kimi-logo.png" />
  </ItemGroup>

</Project>
