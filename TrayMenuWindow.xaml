<Window x:Class="KimiPlanbarTray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="150" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Border CornerRadius="12" Background="{DynamicResource WindowBgBrush}" Margin="5" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Button Content="打开" Style="{StaticResource MenuItemButton}" Click="OpenClick"/>
            <Button Content="刷新" Style="{StaticResource MenuItemButton}" Click="RefreshClick"/>
            <Button Content="设置" Style="{StaticResource MenuItemButton}" Click="SettingsClick"/>
            <Button Content="退出" Style="{StaticResource MenuItemButton}" Click="ExitClick"/>
        </StackPanel>
    </Border>
</Window>
