<Window x:Class="KimiPlanbarTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="420" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Border CornerRadius="14" Background="{DynamicResource WindowBgBrush}" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（可拖动） -->
            <DockPanel Grid.Row="0" Margin="2,0,2,16" MouseLeftButtonDown="TitleBarDrag">
                <Image Source="pack://application:,,,/kimi-logo.png" Width="18" Height="18"
                       DockPanel.Dock="Left"/>
                <TextBlock Text="Kimi Planbar Tray 设置" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="✕" Style="{StaticResource ChromeCloseButton}"
                        DockPanel.Dock="Right" Click="CloseClick"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="6,0,4,0">
                <TextBlock Text="主题" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <RadioButton x:Name="ThemeSystem" Content="跟随系统" Margin="0,10,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>
                <RadioButton x:Name="ThemeLight" Content="月之亮面" Margin="0,8,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>
                <RadioButton x:Name="ThemeDark" Content="月之暗面" Margin="0,8,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>

                <TextBlock Text="刷新间隔" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton Content="1 分钟" Tag="1" GroupName="interval"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="5 分钟" Tag="5" GroupName="interval" IsChecked="True"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="10 分钟" Tag="10" GroupName="interval"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="30 分钟" Tag="30" GroupName="interval"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>

                <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Margin="0,22,0,0"
                          Style="{StaticResource ThemeCheckBox}"/>

                <Button Content="保存" Style="{StaticResource ActionButton}" Margin="0,26,0,0"
                        Click="SaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
