<Window x:Class="KimiPlanbarTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KimiPlanbar 设置" Width="340" Height="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="主题" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <RadioButton x:Name="ThemeSystem" Content="跟随系统" Margin="0,10,0,0" GroupName="theme"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
        <RadioButton x:Name="ThemeLight" Content="月之亮面" Margin="0,8,0,0" GroupName="theme"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
        <RadioButton x:Name="ThemeDark" Content="月之暗面" Margin="0,8,0,0" GroupName="theme"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Text="刷新间隔" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <ComboBox x:Name="IntervalBox" Margin="0,10,0,0" HorizontalAlignment="Left" Width="120">
            <ComboBoxItem Content="1 分钟" Tag="1"/>
            <ComboBoxItem Content="5 分钟" Tag="5" IsSelected="True"/>
            <ComboBoxItem Content="10 分钟" Tag="10"/>
            <ComboBoxItem Content="30 分钟" Tag="30"/>
        </ComboBox>

        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" Margin="0,20,0,0"
                  Foreground="{DynamicResource TextPrimaryBrush}"/>

        <Button Content="保存" Style="{StaticResource ActionButton}" Margin="0,26,0,0"
                Click="SaveClick"/>
    </StackPanel>
</Window>
