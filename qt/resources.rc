// Windows VERSIONINFO + application icon for the qt edition exe.
// Values mirror the rust release exe (CompanyName shawnqi, ProductName
// KimiPlanbarTray). Icon: assets/icon.ico, generated from assets/icon.png.

#include <windows.h>

1 ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION 1, 7, 2, 0
PRODUCTVERSION 1, 7, 2, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "shawnqi"
            VALUE "FileDescription", "KimiPlanbarTray"
            VALUE "FileVersion", "1.7.2"
            VALUE "ProductName", "KimiPlanbarTray"
            VALUE "ProductVersion", "1.7.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
